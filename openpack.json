{
  "schemaVersion": 3,
  "name": "nestdevlab/must-have-standard",
  "version": "0.2.8",
  "compositionRules": [
    {
      "target": "skills/*",
      "include": "core:fragments/skill-evolution.md",
      "exclude": ["nestdev-core-toolkit:skills/skill-evolution"],
      "runtimes": ["codex", "claude"]
    }
  ],
  "requires": {
    "agent-toolkit": {
      "source": "git:https://github.com/eai-org/agent-toolkit.git#17f5861e66800e0c0af702ea837ad7911c42099f",
      "mode": "pinned",
      "select": [
        "rules/no-nonsense-comments.md",
        "rules/self-contained-docs.md",
        "skills/context-checkup"
      ]
    },
    "agent-toolkit-self-improve": {
      "source": "git:https://github.com/eai-org/agent-toolkit.git#17f5861e66800e0c0af702ea837ad7911c42099f",
      "mode": "pinned",
      "select": [
        "rules/self-improve-on-correction.md",
        "skills/self-improve"
      ],
      "runtimes": ["codex", "claude"]
    },
    "core": {
      "source": "github:NestDevLab/agent-core-toolkit-public",
      "ref": "main",
      "mode": "tracking",
      "select": [
        "fragments/skill-evolution.md",
        "skills/code-review",
        "skills/plan-task"
      ]
    },
    "mattpocock-skills": {
      "source": "skillkit:github:mattpocock/skills",
      "ref": "main",
      "mode": "pinned",
      "select": [
        "skills/grill-me"
      ]
    }
  }
}
